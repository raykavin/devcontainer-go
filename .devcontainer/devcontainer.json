{
    "name": "my-app DevContainer (Go)",
    "workspaceFolder": "/workspaces/app",
    "dockerComposeFile": [
        "docker-compose.yml"
    ],
    "service": "workspace",
    "remoteUser": "vscode",
    "containerEnv": {
        "TZ": "America/Belem",
        "PROJECT_NAME": "my-app",
        "GIT_CONFIG_DEV_USERNAME": "your_username",
        "GIT_CONFIG_DEV_EMAIL": "your_email@domain.com",
        "GIT_CONFIG_TOKEN": "",
        "GIT_REPO_ADDRESS": "github.com/your_username/my-app.git",
        "GIT_INIT_DEFAULT_BRANCH": "feat/initial-setup",
        "GO_PROXY_HOST": "",
        "GO_PROXY_PORT": ""
    },
    "forwardPorts": [
        3000
    ],
    "portsAttributes": {
        "3000": {
            "label": "Backend (Go API)",
            "onAutoForward": "notify"
        }
    },
    "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.claude",
    "postCreateCommand": "sh ./.devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "liuchao.go-struct-tag",
                "yokoe.vscode-postfix-go",
                "neonxp.gotools",
                "tooltitudeteam.tooltitude",
                "streetsidesoftware.code-spell-checker",
                "streetsidesoftware.code-spell-checker-portuguese-brazilian",
                "redhat.vscode-yaml",
                "teddyandturtle.fish",
                "usernamehw.errorlens",
                "mhutchie.git-graph"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "fish",
                "go.toolsManagement.checkForUpdates": "local",
                "go.useLanguageServer": true,
                "editor.formatOnSave": true,
                "[go]": {
                    "editor.defaultFormatter": "golang.go"
                }
            }
        }
    }
}